# ARGUS — Environment Variables
# Copy to .env and fill in values

# Master encryption key for document storage (Fernet key, base64-encoded)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARGUS_MASTER_KEY=

# LLM API key (DeepSeek or compatible provider)
ARGUS_LLM_API_KEY=

# API authentication key for the ARGUS REST API
ARGUS_API_KEY=

# Optional: Override config file path
# ARGUS_CONFIG_PATH=./config.yaml

# Optional: Override data directory
# ARGUS_DATA_DIR=./data

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# ARGUS_LOG_LEVEL=INFO
